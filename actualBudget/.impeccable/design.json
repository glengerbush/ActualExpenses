  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Standard action with theme-aware interaction states.",
      "html": "<button class=\"ds-primary\">Save</button>",
      "css": ".ds-primary { min-height:44px; padding:0.55rem 1rem; border:1px solid var(--accent, #6035b5); border-radius:6px; background:var(--accent, #6035b5); color:var(--primary-text, #fff); font:600 1rem system-ui,sans-serif; cursor:pointer; } .ds-primary:hover { background:var(--primary-hover, #4f299b); } .ds-primary:active { background:var(--primary-active, #3d1b7e); } .ds-primary:focus-visible { outline: 3px solid var(--focus, #7342cf); outline-offset: 3px; }"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Standard action with theme-aware interaction states.",
      "html": "<button class=\"ds-secondary\">Add group</button>",
      "css": ".ds-secondary { min-height:44px; padding:0.55rem 1rem; border:1px solid var(--button-border, #d0c4e4); border-radius:6px; background:var(--button-surface, #fff); color:var(--button-text, #48247e); font:600 1rem system-ui,sans-serif; cursor:pointer; } .ds-secondary:hover { background:var(--hover, #f4effb); } .ds-secondary:active { background:var(--pressed, #e9def8); } .ds-secondary:focus-visible { outline: 3px solid var(--focus, #7342cf); outline-offset: 3px; }"
    },
    {
      "name": "Text input",
      "kind": "input",
      "refersTo": "input",
      "description": "Native labeled field.",
      "html": "<label class=\"ds-label\">Category<input class=\"ds-input\" value=\"Groceries\" /></label>",
      "css": ".ds-label { display:grid; gap:0.4rem; font:600 1rem system-ui,sans-serif; color:var(--text,#231a35); } .ds-input { min-height:44px; padding:0.6rem 0.7rem; border:1px solid var(--control-border,#9b8bb4); border-radius:5px; background:var(--input-surface,#fff); color:var(--input-text,#231a35); font:400 1rem system-ui,sans-serif; } .ds-input:focus-visible { outline: 3px solid var(--focus, #7342cf); outline-offset: 3px; }"
    },
    {
      "name": "Current navigation",
      "kind": "nav",
      "refersTo": "navigation-current",
      "description": "Icon and text remain visible in selected navigation.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-current\" aria-current=\"page\"><svg aria-hidden=\"true\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 7 9-4 9 4-9 4-9-4Zm0 5 9 4 9-4M3 17l9 4 9-4\"/></svg>Budget</button></nav>",
      "css": ".ds-nav { padding:0.75rem; background:var(--sidebar,#2e1555); } .ds-current { display:flex; align-items:center; gap:0.8rem; min-height:44px; width:100%; padding:0.75rem; border:0; border-radius:6px; background:var(--sidebar-active,#dfd1fc); color:var(--sidebar-active-text,#321568); font:700 1rem system-ui,sans-serif; cursor:pointer; } .ds-current:hover { background:var(--sidebar-active,#dfd1fc); color:var(--sidebar-active-text,#321568); } .ds-current:focus-visible { outline:3px solid #e0caff; outline-offset:3px; }"
    },
    {
      "name": "Remaining badge",
      "kind": "chip",
      "refersTo": "remaining-badge",
      "description": "Signed amount and semantic color indicate remaining balance.",
      "html": "<span class=\"ds-badge\">$240.00</span> <span class=\"ds-badge ds-negative\">\u2212$24.00</span>",
      "css": ".ds-badge { display:inline-block; border-radius:7px; padding:0.1rem 0.6rem; color:var(--success,#236630); background:var(--success-bg,#d8f0ce); font:650 1rem system-ui,sans-serif; font-variant-numeric:tabular-nums; } .ds-negative { color:var(--error,#a32e39); background:var(--error-bg,#fff0f1); }"
    },
    {
      "name": "Monthly summary",
      "kind": "card",
      "refersTo": "summary",
      "description": "Three compact totals share one panel.",
      "html": "<dl class=\"ds-summary\"><div><dt>Planned</dt><dd>$2,000.00</dd></div><div><dt>Spent</dt><dd>$1,760.00</dd></div><div><dt>Remaining</dt><dd><span class=\"ds-total\">$240.00</span></dd></div></dl>",
      "css": ".ds-summary { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin:0; padding:1rem 0; border:1px solid var(--line,#e0d9ed); border-radius:8px; background:var(--budget-panel-surface,var(--hover,#f4effb)); color:var(--text,#231a35); text-align:center; font-family:system-ui,sans-serif; } .ds-summary>div+div { border-left:1px solid var(--line,#e0d9ed); } .ds-summary dt { font-size:0.9rem; } .ds-summary dd { margin:0.25rem 0 0; font-size:1.5rem; font-weight:750; font-variant-numeric:tabular-nums; } .ds-total { display:inline-block; border-radius:7px; padding:0.1rem 0.6rem; background:var(--success-bg,#d8f0ce); color:var(--success,#236630); font-weight:650; }"
    },
    {
      "name": "Rounded category group",
      "kind": "custom",
      "refersTo": "group-header",
      "description": "Explicit user requirements: continuous color border and 8px outer corners around each whole group.",
      "html": "<table class=\"ds-table\"><tbody><tr class=\"ds-group\"><th>Food</th><td>$400.00</td></tr><tr><th>Groceries</th><td>$300.00</td></tr><tr><th>Dining out</th><td>$100.00</td></tr></tbody></table>",
      "css": ".ds-table { border-collapse:separate; border-spacing:0; width:100%; background:var(--surface,#fff); color:var(--text,#231a35); font:1rem system-ui,sans-serif; } .ds-table th,.ds-table td { padding:0.15rem 0.6rem; height:44px; border-bottom:1px solid var(--line,#e0d9ed); } .ds-table th { text-align:left; font-weight:400; border-left:4px solid var(--group-color,#6846bd); } .ds-table td { text-align:right; font-variant-numeric:tabular-nums; } .ds-group > * { background:var(--budget-group-surface,var(--selected,#eee3ff)); border-top:1px solid var(--line,#e0d9ed); } .ds-group th,.ds-group td { font-weight:650; } .ds-table tr > :last-child { border-right:1px solid var(--line,#e0d9ed); } .ds-table tbody > tr:first-child > :first-child { border-top-left-radius:8px; } .ds-table tbody > tr:first-child > :last-child { border-top-right-radius:8px; } .ds-table tbody > tr:last-child > :first-child { border-bottom-left-radius:8px; } .ds-table tbody > tr:last-child > :last-child { border-bottom-right-radius:8px; } .ds-table tbody + tbody::before { content:\"\"; display:table-row; height:12px; }"
    },
    {
      "name": "Color palette",
      "kind": "custom",
      "refersTo": "color-palette",
      "description": "Swatches and native custom color control in an elevated palette.",
      "html": "<div class=\"ds-palette\" role=\"group\" aria-label=\"Color palette\"><div class=\"ds-swatches\"><button class=\"ds-swatch\" style=\"--swatch:#8a3e89\" aria-label=\"Plum\"><span></span></button><button class=\"ds-swatch\" style=\"--swatch:#6846bd\" aria-label=\"Indigo\" aria-pressed=\"true\"><span></span></button><button class=\"ds-swatch\" style=\"--swatch:#3182d5\" aria-label=\"Blue\"><span></span></button><button class=\"ds-swatch\" style=\"--swatch:#169d98\" aria-label=\"Teal\"><span></span></button><button class=\"ds-swatch\" style=\"--swatch:#4d923e\" aria-label=\"Green\"><span></span></button><button class=\"ds-swatch\" style=\"--swatch:#d68b13\" aria-label=\"Amber\"><span></span></button></div><label class=\"ds-custom\">Custom color<input type=\"color\" value=\"#6846bd\" /></label></div>",
      "css": ".ds-palette { width:264px; padding:12px; border-radius:12px; background:var(--surface,#fff); color:var(--text,#231a35); box-shadow:0 6px 24px color-mix(in srgb,var(--text,#231a35) 22%,transparent); font-family:system-ui,sans-serif; } .ds-swatches { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); } .ds-swatch { display:grid; place-items:center; width:40px; min-height:40px; padding:6px; border:0; border-radius:6px; background:transparent; cursor:pointer; } .ds-swatch span { width:20px; height:20px; border-radius:50%; background:var(--swatch); border:1px solid color-mix(in srgb,var(--text,#231a35) 18%,transparent); } .ds-swatch:hover { background:var(--hover,#f4effb); } .ds-swatch:active { background:var(--pressed,#e9def8); } .ds-swatch:focus-visible { outline: 3px solid var(--focus, #7342cf); outline-offset: 3px; } .ds-swatch[aria-pressed=\"true\"] span { outline:2px solid var(--accent,#6035b5); outline-offset:2px; } .ds-custom { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-top:8px; padding-top:8px; border-top:1px solid var(--line,#e0d9ed); font-size:0.875rem; font-weight:500; } .ds-custom input { width:44px; height:36px; padding:4px; border:1px solid var(--control-border,#9b8bb4); border-radius:5px; background:var(--surface,#fff); } .ds-custom input:focus-visible { outline: 3px solid var(--focus, #7342cf); outline-offset: 3px; }"
    }
  ],
  "narrative": {
    "northStar": "Classic indigo budget",
    "overview": "The approved classic indigo direction frames a white financial workspace with deep indigo navigation, lavender group headers and a lavender category inspector. Compact rows, exact amounts and familiar controls make everyday budget work easy to scan.\n\nThis documents the implemented full web interface. The installed iPhone expense companion and Android actualExpenses retain their separate focused workflows. Colors follow the selected light, dark or midnight theme; custom group and category colors remain user data.",
    "keyCharacteristics": [
      "Deep indigo navigation with lavender selection.",
      "Compact financial tables and tabular, right-aligned amounts.",
      "Continuous group-color borders and editable color swatches.",
      "Useful detail in the inspector; income and savings available for each month."
    ],
    "rules": [
      {
        "name": "Group Continuity",
        "body": "Carry the selected group color as a continuous 4px left border through its header and category rows, following the whole group\u2019s 8px outer corners. Both the continuous border and rounded groups are explicit user requirements.",
        "section": "colors"
      },
      {
        "name": "Financial Legibility",
        "body": "Keep amounts exact, tabular and right-aligned; preserve signed values and text labels alongside semantic color.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve the approved indigo, white and lavender hierarchy across themes.",
      "Do keep the continuous group-color border and whole-group rounded corners; the user explicitly requested both.",
      "Do retain single-month default, multi-month access and each month\u2019s income/savings details.",
      "Do keep financial amounts exact and wait for persisted results before changing balances.",
      "Do retain keyboard access, named controls, visible focus, mobile scrolling and actionable recovery."
    ],
    "donts": [
      "Don\u2019t restore the retired forest-green navigation or accounts-first shell.",
      "Don\u2019t replace working budget, transaction, report, import, rule or schedule features with placeholders.",
      "Don\u2019t add bank-connection, envelope-method, reconciliation or pending-expense workflows.",
      "Don\u2019t rely on color alone for meaning or remove labels to imitate the mockup.",
      "Don\u2019t apply the full desktop budget shell to the installed iPhone companion."
    ]
  }
}
