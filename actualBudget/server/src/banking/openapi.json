{
  "paths": {
    "/api/v1/budgets/{budget}/banking": {
      "get": {
        "summary": "Read sanitized bank connections; never contacts provider",
        "parameters": [
          {
            "in": "path",
            "name": "budget",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Sanitized durable outcome",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BankState"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Budget not found"
          }
        }
      }
    },
    "/api/v1/budgets/{budget}/banking/connections": {
      "post": {
        "summary": "Stage one-use setup token in server-only custody",
        "parameters": [
          {
            "in": "path",
            "name": "budget",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "required": true
          },
          {
            "in": "header",
            "name": "X-Actual-Budget-Epoch",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "required": false,
            "description": "Original captured epoch. Required for provider downloads; persist with the immutable command before sending."
          },
          {
            "in": "header",
            "name": "X-Actual-Cancel-If-Uncommitted",
            "schema": {
              "const": "true"
            },
            "required": false
          },
          {
            "in": "header",
            "name": "X-Actual-Receipt-Only",
            "schema": {
              "const": "true"
            },
            "required": false
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BankConnectionCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sanitized durable outcome",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BankConnection"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or unsafe provider URL"
          },
          "404": {
            "description": "Missing connection or unknown receipt"
          },
          "409": {
            "description": "Changed generation, canceled operation or different payload under same key"
          },
          "503": {
            "description": "Bounded provider workers busy"
          }
        }
      }
    },
    "/api/v1/budgets/{budget}/banking/connections/{id}/commands": {
      "post": {
        "summary": "Claim once; ambiguous claims require replacement, exact committed retries never repeat transport",
        "parameters": [
          {
            "in": "path",
            "name": "budget",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "required": true
          },
          {
            "in": "header",
            "name": "X-Actual-Budget-Epoch",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "required": false,
            "description": "Original captured epoch. Required for provider downloads; persist with the immutable command before sending."
          },
          {
            "in": "header",
            "name": "X-Actual-Cancel-If-Uncommitted",
            "schema": {
              "const": "true"
            },
            "required": false
          },
          {
            "in": "header",
            "name": "X-Actual-Receipt-Only",
            "schema": {
              "const": "true"
            },
            "required": false
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BankConnectionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sanitized durable outcome",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/BankConnection"
                        }
                      },
                      "required": [
                        "data"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/BankDiscovery"
                        }
                      },
                      "required": [
                        "data"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or unsafe provider URL"
          },
          "404": {
            "description": "Missing connection or unknown receipt"
          },
          "409": {
            "description": "Changed generation, canceled operation or different payload under same key"
          },
          "503": {
            "description": "Bounded provider workers busy"
          },
          "429": {
            "description": "Local rolling 24-hour connection request quota exhausted; no remote request made"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BankConnection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "const": "simplefin"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "enum": [
              "claim_pending",
              "claim_inflight",
              "connected",
              "claim_failed",
              "credentials_missing"
            ]
          },
          "generation": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_success": {
            "type": [
              "string",
              "null"
            ]
          },
          "deleted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "provider",
          "name",
          "state",
          "generation",
          "revision",
          "error_code",
          "message",
          "last_success",
          "deleted"
        ],
        "additionalProperties": false
      },
      "BankConnectionCreate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "const": "simplefin"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "setup_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "writeOnly": true,
            "description": "Base64 one-use HTTPS claim URL. Stored only in the private server credential store; generic receipts retain a SHA-256 fingerprint."
          }
        },
        "required": [
          "id",
          "provider",
          "name",
          "setup_token"
        ],
        "additionalProperties": false
      },
      "BankConnectionCommand": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "claim"
              },
              "generation": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "action",
              "generation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "replace"
              },
              "generation": {
                "type": "string",
                "format": "uuid"
              },
              "setup_token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "writeOnly": true
              }
            },
            "required": [
              "action",
              "generation",
              "setup_token"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "remove"
              },
              "generation": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "action",
              "generation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "discover"
              },
              "generation": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "action",
              "generation"
            ],
            "additionalProperties": false
          }
        ]
      },
      "BankState": {
        "type": "object",
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BankConnection"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BankLink"
            }
          },
          "epoch": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "snapshot": {
            "type": "string",
            "minLength": 50,
            "maxLength": 50
          },
          "accounts": {
            "type": "array",
            "maxItems": 5000,
            "items": {
              "$ref": "#/components/schemas/BankRemoteAccount"
            }
          }
        },
        "required": [
          "connections",
          "links",
          "epoch",
          "snapshot",
          "accounts"
        ],
        "additionalProperties": false
      },
      "BankRemoteAccount": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "connection_id": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "string",
            "format": "uuid"
          },
          "remote_connection_id": {
            "type": "string"
          },
          "remote_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "balance": {
            "type": "string"
          },
          "available_balance": {
            "type": [
              "string",
              "null"
            ]
          },
          "balance_date": {
            "type": "integer"
          },
          "diagnostics": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/BankDiagnostic"
            }
          },
          "deleted": {
            "type": "boolean"
          },
          "institution": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "connection_id",
          "generation",
          "remote_connection_id",
          "remote_id",
          "name",
          "currency",
          "balance",
          "available_balance",
          "balance_date",
          "diagnostics",
          "deleted",
          "institution"
        ],
        "additionalProperties": false
      },
      "BankLink": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "connection_id": {
            "type": "string",
            "format": "uuid"
          },
          "remote_account_id": {
            "type": "string",
            "format": "uuid"
          },
          "connection_generation": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "deleted": {
            "type": "boolean"
          },
          "initial_sync": {
            "type": "boolean"
          },
          "opening_mode": {
            "enum": [
              "auto",
              "none",
              "custom"
            ]
          },
          "opening_amount": {
            "type": [
              "integer",
              "null"
            ]
          },
          "opening_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_sync_end": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "connection_id",
          "remote_account_id",
          "connection_generation",
          "revision",
          "deleted",
          "initial_sync",
          "opening_mode",
          "opening_amount",
          "opening_date",
          "last_sync_end"
        ],
        "additionalProperties": false
      },
      "BankDiagnostic": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "remote_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "remote_connection_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "BankDiscovery": {
        "type": "object",
        "properties": {
          "connection": {
            "$ref": "#/components/schemas/BankConnection"
          },
          "accounts": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/BankRemoteAccount"
            }
          },
          "errors": {
            "type": "array",
            "maxItems": 1001,
            "items": {
              "$ref": "#/components/schemas/BankDiagnostic"
            }
          }
        },
        "required": [
          "connection",
          "accounts",
          "errors"
        ],
        "additionalProperties": false
      }
    }
  }
}
