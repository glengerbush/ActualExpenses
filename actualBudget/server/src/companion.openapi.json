{
  "paths": {
    "/api/v1/budgets/{budget}/companion": {
      "get": {
        "summary": "Latest ten qualifying expenses plus explicitly retained older entries",
        "parameters": [
          {
            "name": "budget",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "retain",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 3700,
              "description": "Comma-separated canonical UUIDs, at most100; entries outside this account or no longer eligible are returned as unavailable."
            }
          },
          {
            "name": "snapshot",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 50,
              "maxLength": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Atomic bounded view and cursor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CompanionView"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or retained identifiers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "snapshot_changed; reload the coherent view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Budget or open account not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "budget_deleted; keep queued work for recovery",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompanionView": {
        "type": "object",
        "required": [
          "recent",
          "retained",
          "unavailable",
          "snapshot",
          "epoch"
        ],
        "properties": {
          "recent": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "description": "Date descending, sort rank descending, ID ascending. Ordinary negative unreconciled entries across all sources."
          },
          "retained": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          },
          "unavailable": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "snapshot": {
            "type": "string"
          },
          "epoch": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          }
        }
      }
    }
  }
}
