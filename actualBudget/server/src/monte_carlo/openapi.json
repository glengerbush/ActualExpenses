  "paths": {
    "/api/v1/budgets/{budget}/reports/monte-carlo": {
      "post": {
        "description": "Experimental opt-in; read-only seeded planning. Input64KiB,256 entries per collection; source1000\u201310000 random runs and1\u2013100 years (historical replay uses98 starts). One global worker,64MiB runtime heap,1MiB stack,20s execution interruption,8MiB output. Captures linked balances/epoch/snapshot before computing outside SQLite. Cache8 entries/16MiB keyed by resolved inputs and epoch; no financial writes. Cancel using the client-generated request_id; requests and statuses are ephemeral. Financial summaries are estimates, not guaranteed outcomes.",
        "parameters": [
          {
            "name": "budget",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MonteCarloRequest"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Invalid plan or resource bound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Browser origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Budget or active request missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Feature disabled, duplicate active request or simulation cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
