  "components": {
    "schemas": {
      "Budget": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Nonblank; no control characters."
          },
          "budget_type": {
            "type": "string",
            "enum": [
              "tracking",
              "envelope"
            ],
            "default": "tracking"
          }
        },
        "required": [
          "id",
          "name",
          "budget_type"
        ],
        "additionalProperties": false
      },
      "NewBudget": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Nonblank; no control characters."
          },
          "budget_type": {
            "type": "string",
            "enum": [
              "tracking",
              "envelope"
            ],
            "default": "tracking"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Nonblank; no control characters."
          },
          "notes": {
            "type": "string",
            "maxLength": 10000,
            "default": ""
          },
          "off_budget": {
            "type": "boolean",
            "default": false
          },
          "closed": {
            "type": "boolean"
          },
          "balance": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Signed integer minor currency units, safe for JavaScript. No floating point."
          }
        },
        "required": [
          "id",
          "name",
          "notes",
          "off_budget",
          "closed",
          "balance"
        ],
        "additionalProperties": false
      },
      "NewAccount": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Nonblank; no control characters."
          },
          "notes": {
            "type": "string",
            "maxLength": 10000,
            "default": ""
          },
          "off_budget": {
            "type": "boolean",
            "default": false
          },
          "opening_balance": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Signed integer minor currency units, safe for JavaScript. No floating point."
          },
          "opening_date": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Calendar date YYYY-MM-DD, year 0001\u20139999."
          }
        },
        "required": [
          "id",
          "name",
          "opening_balance",
          "opening_date"
        ],
        "additionalProperties": false
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "account_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "amount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Signed integer minor currency units, safe for JavaScript. No floating point."
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "cleared": {
            "type": "boolean"
          },
          "reconciled": {
            "type": "boolean"
          },
          "starting_balance": {
            "type": "boolean"
          },
          "payee_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "payee_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "category_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "category_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "category_is_income": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "account_id",
          "amount",
          "date",
          "cleared",
          "reconciled",
          "starting_balance",
          "payee_id",
          "payee_name",
          "category_id",
          "category_name",
          "category_is_income"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Info": {
        "type": "object",
        "properties": {
          "name": {
            "const": "actualBudget"
          },
          "version": {
            "type": "string"
          },
          "api_version": {
            "const": 1
          },
          "authentication": {
            "const": "none"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "openapi": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "api_version",
          "authentication",
          "capabilities",
          "openapi"
        ],
        "additionalProperties": false
      }
    }
  }
}
