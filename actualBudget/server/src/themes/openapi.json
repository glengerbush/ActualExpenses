{
  "paths": {
    "/api/v1/themes/compile": {
      "post": {
        "operationId": "themecompile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "css"
                ],
                "additionalProperties": false,
                "properties": {
                  "css": {
                    "type": "string",
                    "maxLength": 16777216
                  },
                  "base_theme": {
                    "enum": [
                      "light",
                      "dark",
                      "midnight"
                    ],
                    "default": "light"
                  },
                  "id": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "repo": {
                    "type": "string",
                    "maxLength": 2048
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compiled device data; no server persistence",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CompiledTheme"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid theme request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Theme request exceeds body limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json content type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/themes/convert-actual": {
      "post": {
        "operationId": "themeconvert_actual",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "global"
                ],
                "properties": {
                  "global": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compiled device data; no server persistence",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ConvertedThemes"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid theme request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Theme request exceeds body limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json content type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/themes/catalog": {
      "get": {
        "operationId": "themeCatalog",
        "responses": {
          "200": {
            "description": "Compiled device data; no server persistence",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "version",
                        "entries",
                        "token_map",
                        "limits"
                      ],
                      "properties": {
                        "version": {
                          "const": 1
                        },
                        "entries": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "name",
                              "repo",
                              "mode"
                            ],
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "repo": {
                                "type": "string"
                              },
                              "mode": {
                                "enum": [
                                  "light",
                                  "dark"
                                ]
                              },
                              "colors": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        },
                        "token_map": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "limits": {
                          "type": "object",
                          "required": [
                            "css_bytes",
                            "font_bytes",
                            "total_font_bytes"
                          ],
                          "properties": {
                            "css_bytes": {
                              "type": "integer"
                            },
                            "font_bytes": {
                              "type": "integer"
                            },
                            "total_font_bytes": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ThemeWarning": {
        "type": "object",
        "required": [
          "key",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "CompiledTheme": {
        "type": "object",
        "required": [
          "version",
          "id",
          "name",
          "repo",
          "base_theme",
          "source",
          "valid",
          "variables",
          "fonts",
          "warnings",
          "variables_by_base"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "base_theme": {
            "enum": [
              "light",
              "dark",
              "midnight"
            ]
          },
          "source": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "variables": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "fonts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThemeWarning"
            }
          },
          "variables_by_base": {
            "type": "object",
            "required": [
              "light",
              "dark",
              "midnight"
            ],
            "additionalProperties": false,
            "properties": {
              "light": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "dark": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "midnight": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ConvertedThemes": {
        "type": "object",
        "required": [
          "version",
          "light",
          "dark",
          "override",
          "original",
          "warnings"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "light": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompiledTheme"
              },
              {
                "type": "null"
              }
            ]
          },
          "dark": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompiledTheme"
              },
              {
                "type": "null"
              }
            ]
          },
          "override": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompiledTheme"
              },
              {
                "type": "null"
              }
            ]
          },
          "original": {
            "type": "object"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThemeWarning"
            }
          }
        }
      }
    }
  }
}
